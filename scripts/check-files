#!/usr/bin/env bash

ret=0
while read -r file; do
	mv "${file}" "${file}.bak"
	make clean &> /dev/null
	make &> /dev/null
	if [ "$?" == "0" ] ; then
		echo "not required: $file"
		ret=1
	else
		echo "    required: $file"
	fi
	mv "${file}.bak" "${file}"

done < <(find . \( -name "*.h" -o -name "*.dtsi" \))

exit $ret
